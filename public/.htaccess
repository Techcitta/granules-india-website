<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force apex (non-www) domain to www.granulesindia.com with HTTPS
  RewriteCond %{HTTP_HOST} ^granulesindia\.com$ [NC]
  RewriteRule ^(.*)$ https://www.granulesindia.com/$1 [L,R=301]

  # 2. Force HTTPS Redirection (Supports Apache direct, Cloudflare, AWS Amplify/ALB, and cPanel proxies)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect any /public_html or /public_html/* directly to clean URL
  RewriteRule ^public_html/?(.*)$ /$1 [R=301,L]

  # 3. Map legacy Google-indexed URLs directly to active pages
  RewriteRule ^about-us/our-leadership/?(.*)$ /company/leadership [R=301,L]
  RewriteRule ^about-us/leadership/?(.*)$ /company/leadership [R=301,L]
  RewriteRule ^about-us/our-board/?(.*)$ /company/leadership [R=301,L]
  RewriteRule ^granules-usa/management-team/?(.*)$ /company/leadership [R=301,L]
  RewriteRule ^management-team/?(.*)$ /company/leadership [R=301,L]
  RewriteRule ^about-us/our-journey/?(.*)$ /company/milestone [R=301,L]
  RewriteRule ^about-us/milestones/?(.*)$ /company/milestone [R=301,L]
  RewriteRule ^about-us/research-development-api/?(.*)$ /business/rd [R=301,L]
  RewriteRule ^about-us/research-development/?(.*)$ /business/rd [R=301,L]
  RewriteRule ^research-development/?(.*)$ /business/rd [R=301,L]
  RewriteRule ^about-us/operational-excellence/?(.*)$ /company/operational-excellence [R=301,L]
  RewriteRule ^operational-excellence/?(.*)$ /company/operational-excellence [R=301,L]
  RewriteRule ^our-purpose-vision-values/?(.*)$ /company [R=301,L]
  RewriteRule ^about-us/?(.*)$ /company [R=301,L]
  RewriteRule ^about/?$ /company [R=301,L]
  RewriteRule ^careers/testimonials/?(.*)$ /careers/life-at-granules [R=301,L]
  RewriteRule ^granules-usa/careers/testimonials/?(.*)$ /careers/life-at-granules [R=301,L]
  RewriteRule ^careers/current-openings/?(.*)$ /careers [R=301,L]
  RewriteRule ^granules-usa/careers/current-openings/?(.*)$ /careers [R=301,L]
  RewriteRule ^granules-usa/careers/?(.*)$ /careers [R=301,L]
  RewriteRule ^granules-usa/?(.*)$ /company/global-subsidiaries [R=301,L]
  RewriteRule ^contact-us/?(.*)$ /contact [R=301,L]
  RewriteRule ^register-as-supplier/?(.*)$ /contact [R=301,L]
  RewriteRule ^locations/?(.*)$ /business/facilities [R=301,L]
  RewriteRule ^terms-of-use/?(.*)$ /terms-conditions [R=301,L]
  RewriteRule ^esg-profile/?(.*)$ /sustainability/esg-profile [R=301,L]
  RewriteRule ^esg-world/?(.*)$ /sustainability/esg-profile [R=301,L]
  RewriteRule ^products/active-pharmaceutical-ingredients/?(.*)$ /business/api [R=301,L]
  RewriteRule ^products/pharmaceutical-formulation-intermediates/?(.*)$ /business/pfi [R=301,L]
  RewriteRule ^products/finished-dosages/?(.*)$ /business/fd [R=301,L]
  RewriteRule ^investors/financial-reports/annual-reports/?(.*)$ /investor/annual-reports [R=301,L]
  RewriteRule ^investors/financial-reports/?(.*)$ /investor/annual-reports [R=301,L]
  RewriteRule ^investors/press-release/?(.*)$ /media [R=301,L]
  RewriteRule ^investors/investor-resources/buyback/?(.*)$ /investor#sec-investor-resources [R=301,NE,L]
  RewriteRule ^investors/investor-resources/policies/?(.*)$ /investor#sec-investor-resources [R=301,NE,L]
  RewriteRule ^investors/investor-resources/investor-presentation/?(.*)$ /investor#sec-investor-resources [R=301,NE,L]
  RewriteRule ^investors/investor-resources/?(.*)$ /investor#sec-investor-resources [R=301,NE,L]
  RewriteRule ^investors/investor-centre/?(.*)$ /investor [R=301,L]
  RewriteRule ^investors/other-information/?(.*)$ /investor#sec-other-info [R=301,NE,L]
  RewriteRule ^investors/notice-disclosures/?(.*)$ /investor#sec-notices-disclosures [R=301,NE,L]
  RewriteRule ^investors/?$ /investor [R=301,L]
  RewriteRule ^investor\.php$ /investor [R=301,L]
  RewriteRule ^wp-content/?(.*)$ /investor [R=301,L]

  # 4. SPA Fallback: serve index.html for non-file and non-directory requests
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HTTP Strict Transport Security (HSTS) - 1 Year duration + subdomains + preload
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
